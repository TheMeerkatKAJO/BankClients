<Window x:Class="BankClients.DataClient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BankClients"
        mc:Ignorable="d"
        Title="Репризиторий банка" Height="600" Width="900" Activated="DataClient_Actevated">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="60" />
            <Setter Property="Margin" Value="8" />
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="ListBoxElements" Grid.Column="0" ItemsSource="{Binding Accounts}" SelectionMode="Single"  SelectedItem="{Binding SelectedAccount}" Margin="10" SelectionChanged="ListBoxElements_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5">
                        <TextBlock FontSize="16" Text="{Binding AccountNumber}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Balance, StringFormat='Баланс: {0} руб.'}" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="1" Margin="10">

            <TextBlock FontSize="18" FontWeight="Bold" Text="Информация о клиенте"/>
            <Separator Margin="0,5"/>
            
            <TextBlock Text="Фамилия" />
            <TextBox Name="LastName" Text="{Binding SelectedAccount.LastName, UpdateSourceTrigger=PropertyChanged}" FontSize="16" />

            <TextBlock Text="Имя"  />
            <TextBox Name="FirstName" Text="{Binding SelectedAccount.FirstName, UpdateSourceTrigger=PropertyChanged}" FontSize="16"/>

            <TextBlock Text="Отчество" />
            <TextBox Name="SurName" Text="{Binding SelectedAccount.SurName, UpdateSourceTrigger=PropertyChanged}" FontSize="16"/>

            <TextBlock Text="Номер счета" />
            <TextBox Name="AccountNumber" Text="{Binding SelectedAccount.AccountNumber, UpdateSourceTrigger=PropertyChanged}" FontSize="16"/>

            <TextBlock Text="Баланс" />
            <TextBox Name="Balance" Text="{Binding SelectedAccount.Balance, UpdateSourceTrigger=PropertyChanged}" FontSize="16" />

            <TextBlock Text="Дата регистрации" />
            <DatePicker Name="DateRegistration" SelectedDate="{Binding Path = SelectedAccount.DateRegistration}" IsDropDownOpen="True" SelectedDateFormat="Short" FontSize ="20" />

            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1">
                <Button Content="Добавить как новый элемент" Margin="10" Click="AddAccount" Width="230" Height="30" />
                <Button Content="Удалить" Margin="10" Click="DeleteAccount" Width="230" Height="30"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <Button Name ="ButtonMode" Content="Включить режим перевода" Margin="10" Click="ChangeMode" Width="170" Height="30" />
            <Button Content="Совершить перевод" Margin="10" Click="Transfer" Width="170" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
